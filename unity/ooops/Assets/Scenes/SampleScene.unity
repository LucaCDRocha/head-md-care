  inspectionAudio: {fileID: 0}
  cardName: MIDNIGHT EXPRESS
  cardFromWhom: Bert (42)
  cardMainDescription: "When the sun goes down and no one looks, it makes its rounds
    through the caf\xE9, powered by caffeine vapors. Bert insists it only runs on
    schedule if you leave a crumb of blueberry muffin on the tracks as sacrifice
    to the transit gods."
  cardNameFrench: Midnight Express
  cardFromWhomFrench: Bert (42)
  cardMainDescriptionFrench: "Quand le soleil se couche et que personne ne regarde,
    il fait sa tourn\xE9e dans le caf\xE9, propuls\xE9 par les vapeurs de caf\xE9ine.
    Bert insiste sur le fait qu'il n'est \xE0 l'heure que si l'on d\xE9pose une miette
    de muffin aux myrtilles sur les rails, en sacrifice aux dieux du transport."
  idCardPanel: {fileID: 1759364545}
  nameTextUI: {fileID: 1853782753}
  fromWhomTextUI: {fileID: 124690322}
  descriptionTextUI: {fileID: 888095703}
  cardDistance: 0.5
