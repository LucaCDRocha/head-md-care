  inspectionAudio: {fileID: 0}
  cardName: Dumbo the Elephant
  cardFromWhom: Sara (9)
  cardMainDescription: "Sara gave him as a gift. His enormous ears have picked up
    countless conversations over the years \u2014 from first dates to break-ups and
    even questionable business ideas. He might know more neighbourhood secrets than
    Sonia does."
  cardNameFrench: "Dumbo l\u2019\xE9l\xE9phant"
  cardFromWhomFrench: Sara (9)
  cardMainDescriptionFrench: "Sara l\u2019a offert en cadeau. Avec ses \xE9normes
    oreilles, il a surpris d\u2019innombrables conversations au fil des ann\xE9es
    \u2014 des premiers rendez-vous aux ruptures, en passant par quelques id\xE9es
    commerciales douteuses. Il conna\xEEt peut-\xEAtre m\xEAme plus de secrets du
    quartier que Sonia."
  idCardPanel: {fileID: 1759364545}
  nameTextUI: {fileID: 1853782753}
